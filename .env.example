# Copy to .env.local and fill in. Only NEXT_PUBLIC_* vars are read by the client.

# Canonical site origin, no trailing slash. Drives canonical URLs, the sitemap,
# absolute Open Graph image URLs, and the structured-data @id.
# Defaults to https://orientt.com if unset (see src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://orientt.com

# Google Search Console verification token.
# In Search Console, choose the "HTML tag" verification method and copy the
# value from content="..." (just the token, not the whole tag). When set, the
# root layout renders <meta name="google-site-verification" ...> automatically.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
